{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "moduleDetection": "force"
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules"]
}
